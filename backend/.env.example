# Any OpenAI-compatible endpoint works here — FreeLLMAPI or a local Ollama
# both fit. NOTE: port 3001 is also Grafana's port in docker-compose.yml — if
# you run both, an AI call can silently hit Grafana's login redirect instead
# of the LLM instead of erroring. Pick non-colliding ports, e.g. Ollama's
# default of 11434 (http://localhost:11434/v1, model name like "llama3.2:3b",
# any placeholder API key since Ollama doesn't check it).
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=freellmapi-your-unified-key-here
FREELLMAPI_MODEL=auto

# V5: knowledge graph + relational catalog
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
POSTGRES_DSN=postgresql://nexus:your-postgres-password@localhost:5432/nexus

# V9: real-time streaming (Kafka) — defaults to the docker-compose service
# name; use localhost:9092 if running the backend natively against a
# dockerized Kafka broker. Local/docker-compose Kafka is unauthenticated
# PLAINTEXT, so the four lines below can stay unset for local dev.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Only needed against a hosted Kafka (e.g. a free Aiven for Apache Kafka
# service, or Redpanda Cloud) instead of the local docker-compose broker —
# those require login credentials over an encrypted connection. Example
# values for Aiven (from its console's "Connection Information" panel):
#   KAFKA_BOOTSTRAP_SERVERS=<service-name>.aivencloud.com:<port>
#   KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   KAFKA_SASL_MECHANISM=SCRAM-SHA-256
#   KAFKA_SASL_USERNAME=avnadmin
#   KAFKA_SASL_PASSWORD=<its password>
#   KAFKA_SSL_CA_CERT=<the CA Certificate download, pasted as-is>
# Aiven's server certificate is signed by its own private CA, not a public
# one — without KAFKA_SSL_CA_CERT the connection fails with
# CERTIFICATE_VERIFY_FAILED even though the username/password are correct.
# If your platform's env var UI only accepts single-line values, replace
# real newlines in the cert with a literal "\n" — the app un-escapes it.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_CERT=

# Auth: JWT signing key (generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-string
JWT_EXPIRE_MINUTES=1440
